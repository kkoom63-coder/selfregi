// Cloudflare Workers 배포 설정 (Workers Builds: Build command = bash build_cf.sh, Deploy command = npx wrangler deploy)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "selfregi",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  // 대시보드에서 넣은 환경변수·시크릿(TOSSPAY_API_KEY 등)을 배포 때 지우지 않는다.
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // .html 주소를 그대로 유지한다(색인·canonical·sitemap 이 모두 .html).
    "html_handling": "none",
    "not_found_handling": "404-page",
    // 모든 요청을 워커가 먼저 받는다: 루트 도메인 → www 이동, 결제 API, 홈(/) 처리 때문.
    // 무료 한도(하루 10만 요청) 대비 현재 트래픽은 매우 작다.
    "run_worker_first": true
  },
  "observability": { "enabled": true }
}
