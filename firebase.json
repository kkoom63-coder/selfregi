{
  "hosting": {
    "public": "dist",
    "predeploy": [
      "node build_fb.mjs"
    ],
    "cleanUrls": false,
    "redirects": [
      {
        "source": "/index.html",
        "destination": "/",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/api/pay/**",
        "function": {
          "functionId": "pay",
          "region": "asia-northeast3"
        }
      }
    ],
    "headers": [
      {
        "regex": "^/(.*\\.(html|js|css|json|xml|txt))?$",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "regex": "^/[^/]+\\.(png|jpe?g|JPG|webp|svg|gif|ico)$",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      },
      {
        "source": "/ocr/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "predeploy": [
        "node build_fb.mjs"
      ],
      "ignore": [
        "node_modules",
        ".git",
        "*.log",
        ".secret.local",
        ".env.local"
      ]
    }
  ],
  "emulators": {
    "hosting": {
      "port": 5000
    },
    "functions": {
      "port": 5001
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
